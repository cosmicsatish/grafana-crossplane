{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "providerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "roleCatalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixedPath": {
              "type": "string"
            },
            "pluginPath": {
              "type": "string"
            },
            "presetPath": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
